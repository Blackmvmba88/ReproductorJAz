{
  "name": "jasvith-desktop",
  "version": "0.4.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "icon": "node make-icon.cjs",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.blackmamba.jasvith",
    "productName": "Jasvith",
    "directories": {
      "output": "../release",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Jasvith"
    }
  }
}
